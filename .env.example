# Copie este arquivo para ".env" e preencha os valores. Nunca suba o .env para o GitHub.

# Supabase (fase nuvem). Variáveis com prefixo VITE_ vão para o navegador:
# use aqui apenas a chave pública "anon". NUNCA coloque a service_role key em VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Uso apenas local/servidor (migrações, scripts). Não use prefixo VITE_.
SUPABASE_DB_PASSWORD=
